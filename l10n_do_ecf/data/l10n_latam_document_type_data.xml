<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <!--
        Tipos de Comprobante Fiscal Electrónico (e-CF) para República Dominicana.
        Se crean solo si no existen ya (noupdate="1").
        Si l10n_do_accounting está instalado, estos registros pueden coexistir;
        los de l10n_do_accounting tendrán sus propios IDs externos.
    -->

    <!-- E31 - Factura de Crédito Fiscal Electrónica -->
    <record id="ecf_e31_fiscal" model="l10n_latam.document.type">
        <field name="name">Crédito Fiscal Electrónica (E31)</field>
        <field name="code">E</field>
        <field name="doc_code_prefix">E31</field>
        <field name="internal_type">invoice</field>
        <field name="sequence">160</field>
        <field name="active">True</field>
    </record>

    <!-- E32 - Factura de Consumo Electrónica -->
    <record id="ecf_e32_consumer" model="l10n_latam.document.type">
